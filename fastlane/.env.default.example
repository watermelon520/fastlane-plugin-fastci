# 配置模板：复制为 .env.default 后填写项目参数。
# Appstore_connect_api_key
CONNECT_KEY_ID = ""
CONNECT_ISSUER_ID = ""
# 可选：API Key JSON 路径，优先于上面的 Key ID / Issuer ID。
APP_STORE_CONNECT_API_KEY_PATH = ""
# 可选：指定 P8 文件；留空沿用 PACKAGE_FILE_FOLDER_NAME/AuthKey_<KEY_ID>.p8。
APP_STORE_CONNECT_P8_PATH = ""
# 商店资源总开关：必须显式设为 true 才能使用，关闭时只上传 IPA。
APP_STORE_RESOURCES_ENABLED = "false"
# 资源配置路径本身不会启用功能；开启总开关后，package/upload_store 必须配置此路径。
APP_STORE_RESOURCES_CONFIG_PATH = ""

# 项目配置
BUNDLE_ID = "com.example.app"
EXTENSION_BUNDLE_IDS = "" # 可选，多个 Bundle ID 使用 , 分隔
WORKSPACE_NAME = "ExampleApp.xcworkspace"
PROJECT_NAME = "" # ExampleApp.xcodeproj；一个 workspace 有多个 project 时指定
# 请确保 Target 和 Scheme 名称一致
SCHEME_NAME = "ExampleApp"
# 无用代码检测使用，除 SCHEME_NAME 之外还需要检测的。多个 , 分隔
EXTRA_SCHEMES_NAME = ""

# 描述文件配置
PROFILE_DEVELOPMENT = "ExampleApp Development"
PROFILE_ADHOC = "ExampleApp AdHoc"
PROFILE_APPSTORE = "ExampleApp AppStore"
EXTENSION_PROFILES_DEVELOPMENT = ""
EXTENSION_PROFILES_ADHOC = ""
EXTENSION_PROFILES_APPSTORE = ""

# 证书描述文件等放置的文件夹名称(描述文件、证书p12、p8密钥文件等)
PACKAGE_FILE_FOLDER_NAME = "SigningFiles"
# 是否自动更新描述文件，则不需要手动下载描述文件放到本地
IS_AUTO_UPDATE_PROVISIONING = "false"

# p12证书配置
CERTIFICATE_DEVELOPMENT = "development_certificate"
CERTIFICATE_DISTRIBUTION = "distribution_certificate"
CERTIFICATE_PASSWORD = ""
KEYCHAIN_PASSWORD = ""

# 蒲公英配置
PGY_API_KEY = ""
PGY_PASSWORD = ""

# Fir配置
FIR_API_TOKEN = ""
FIR_PASSWORD = ""
FIR_SWITCH_QINIU = "true" #  fir 上传默认使用阿里云，如需切换七牛云则设置为 true

# 钉钉配置（机器人关键词设置为 iOS）
DINGDING_TOKEN = ""

# Sentry 配置
SENTRY_AUTH_TOKEN = ""
SENTRY_ORG_SLUG = ""
SENTRY_PROJECT_SLUG = ""
SENTRY_URL = ""

# Zealot iOS：非商店包按 token 判断是否上传；上传需同时配置 endpoint 和 channel key。
ZEALOT_ENDPOINT = ""
ZEALOT_TOKEN = ""
ZEALOT_CHANNEL_KEY = ""
ZEALOT_UPLOAD_DSYM = "false"
# 可选：ZEALOT_PASSWORD、ZEALOT_TIMEOUT、ZEALOT_VERIFY_SSL、ZEALOT_FAIL_ON_ERROR。
# 设备同步单独配置 ZEALOT_API_PATH（App Store Connect API Key JSON）或 ZEALOT_USERNAME。
